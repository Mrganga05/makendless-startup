# Copy these into Vercel -> Project -> Settings -> Environment Variables (never into the code). See SETUP-GUIDE.md.
# Site URL (optional: defaults to LIVE_URL in data/owner.ts)
NEXT_PUBLIC_SITE_URL=https://makendless.vercel.app
# Supabase (database + team email login)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend (new-lead email alerts)
RESEND_API_KEY=
# Optional: a long random text used to sign /admin sessions (defaults to the service role key)
ADMIN_SESSION_SECRET=
# Weekly /admin backup (Vercel Cron). Any long random text.
CRON_SECRET=
# Meta Pixel ID (optional). Empty = no pixel.
NEXT_PUBLIC_META_PIXEL_ID=
