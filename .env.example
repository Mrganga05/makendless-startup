# Verified contact email shown on the Contact page / used by the inquiry form (mailto).
# Leave empty until the team confirms the real address.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Start a Project leads + referrals (see supabase/schema.sql) — server only, never NEXT_PUBLIC ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# /admin password (Referrals + Leads)
ADMIN_PASSWORD=
# New-lead email alert via resend.com (optional). LEAD_ALERT_TO defaults to the email in data/owner.ts
RESEND_API_KEY=
LEAD_ALERT_TO=
LEAD_ALERT_FROM=
